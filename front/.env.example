# Where the EventX API runs (used by the browser and by server rendering)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public address of this site, used for share links and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google sign-in: the OAuth client ID from Google Cloud (same value as GOOGLE_CLIENT_ID on the API). Leave empty to switch it off.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
