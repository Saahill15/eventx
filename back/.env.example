# Copy to .env for local development. Never commit .env.
DATABASE_URL=sqlite:///./eventx.db

# Required: random string of at least 32 characters.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: created on first start only if no admin exists. Password must be 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: owner account for each seeded fest (12+ character passwords).
ORGANIZER_MOOD_INDIGO_EMAIL=
ORGANIZER_MOOD_INDIGO_PASSWORD=
ORGANIZER_MALHAR_EMAIL=
ORGANIZER_MALHAR_PASSWORD=
ORGANIZER_KALEIDOSCOPE_EMAIL=
ORGANIZER_KALEIDOSCOPE_PASSWORD=
