# Copy to .env for local development. Never commit .env.
DATABASE_URL=sqlite:///./eventx.db

# Required: random string of at least 32 characters.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: created on first start only if no admin exists. Password must be 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: owner account for each seeded fest (12+ character passwords).
ORGANIZER_MOOD_INDIGO_EMAIL=
ORGANIZER_MOOD_INDIGO_PASSWORD=
ORGANIZER_MALHAR_EMAIL=
ORGANIZER_MALHAR_PASSWORD=
ORGANIZER_KALEIDOSCOPE_EMAIL=
ORGANIZER_KALEIDOSCOPE_PASSWORD=

# Email (Brevo) for student verification codes. Leave empty locally: codes are printed in the server log.
# In production set APP_ENV=production, BREVO_API_KEY and MAIL_FROM_EMAIL (a sender verified in Brevo).
APP_ENV=development
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=HiveOut

# Sign-in sessions. Admins are timed out quickly; these are the defaults.
ADMIN_IDLE_MINUTES=15
ADMIN_SESSION_HOURS=8
ORGANIZER_IDLE_MINUTES=120

# Address of the website, used in links the API creates (password reset, announcements)
SITE_URL=http://localhost:3000

# Google sign-in: the OAuth client ID from Google Cloud. Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=

# Features that need a paid plan, comma-separated (for example: short_links). Empty means everything is free.
PAID_FEATURES=
